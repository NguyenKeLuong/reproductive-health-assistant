# ── Core LLM (OpenAI-compatible / FPT Cloud) ──
API_URL=https://mkp-api.fptcloud.com/v1
API_KEY=your_api_key_here
MODEL_NAME=gemma-4-31B-it

# ── NVIDIA NIM APIs (VLM, LLM, STT, TTS) ──
NVIDIA_API_KEY=nvapi-your_primary_nvidia_api_key
NVIDIA_API_KEY_2=nvapi-your_secondary_key_for_benchmarks
NVIDIA_API_KEY_3=nvapi-your_tertiary_key_for_benchmarks
NVIDIA_SPEECH_API_URL=https://integrate.api.nvidia.com/v1

# ── Server Configuration ──
PORT=8010
PYTHONUNBUFFERED=1
